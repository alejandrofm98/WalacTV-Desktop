{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "WalacTV",
  "version": "1.9.0",
  "identifier": "com.walactv.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://iptv.walerike.com https:; img-src 'self' https://image.tmdb.org https: data:; media-src 'self' https: http: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/uosc/": "uosc/",
      "resources/libmpv/": "libmpv/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5NTBBRTFEQ0FBQzVBMjgKUldRb1dxektIYTVRcVFJZU1rdmQ1MFBBMHcyUCs2dkt4NmFsUHVLUEFka05MeXhnclNHWjR5OUsK",
      "endpoints": ["https://github.com/alejandrofm98/walactv-desktop/releases/latest/download/latest.json"]
    }
  }
}
